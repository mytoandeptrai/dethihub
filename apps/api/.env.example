# NestJS API environment variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nestjs-boilerplate"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nestjs-boilerplate"

# Supabase (Auth only)
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1   # default: ${SUPABASE_URL}/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated

# Cloudflare R2
# STORAGE_MAX_BYTES=10485760   # per-account storage cap (default 10 MB)
# STORAGE_DRIVER=supabase   # supabase | r2
# DOC_KEY_SECRET=   # private document key secret (default: SUPABASE_SERVICE_ROLE_KEY)
# SUPABASE_STORAGE_BUCKET=dethihub   # private bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Redis
REDIS_URL="redis://localhost:6379"

# JWT configuration (required)
JWT_SECRET=your-secret-key-change-me-in-production-min-32-chars
# JWT_EXPIRES_IN=15m              # Access token expiry (default: 15m)
# JWT_REFRESH_EXPIRES_IN=7d       # Refresh token expiry (default: 7d)

# Application port (default: 3000)
# PORT=3000

# CORS allowed origins (required in production; comma-separated for multiple)
# ALLOWED_ORIGINS=https://your-frontend.com

# OAuth (optional; login disabled when not set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_CALLBACK_BASE_URL=http://localhost:3000/api/auth/oauth
# FRONTEND_URL=http://localhost:8080
