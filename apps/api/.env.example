# NestJS API environment variables

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nestjs-boilerplate"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nestjs-boilerplate"

# Supabase (Auth only)
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."
# SUPABASE_JWT_ISSUER=https://<ref>.supabase.co/auth/v1   # default: ${SUPABASE_URL}/auth/v1
# SUPABASE_JWT_AUDIENCE=authenticated

# Cloudflare R2
# STORAGE_MAX_BYTES=10485760   # per-account storage cap (default 10 MB)
# STORAGE_DRIVER=supabase   # supabase | r2
# DOC_KEY_SECRET=   # private document key secret (default: SUPABASE_SERVICE_ROLE_KEY)
# SUPABASE_STORAGE_BUCKET=dethihub   # private bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Redis
REDIS_URL="redis://localhost:6379"

# JWT configuration (required)
JWT_SECRET=your-secret-key-change-me-in-production-min-32-chars
# JWT_EXPIRES_IN=15m              # Access token expiry (default: 15m)
# JWT_REFRESH_EXPIRES_IN=7d       # Refresh token expiry (default: 7d)

# Application port (default: 3000)
# PORT=3000

# CORS allowed origins (required in production; comma-separated for multiple)
# ALLOWED_ORIGINS=https://your-frontend.com

# OAuth (optional; login disabled when not set)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# OAUTH_CALLBACK_BASE_URL=http://localhost:3000/api/auth/oauth
# FRONTEND_URL=http://localhost:8080

# Image generation (a provider without a key is skipped)
# AI_IMAGE_POINTS=5
# AGNES_API_KEY=
# AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# AGNES_IMAGE_MODEL=agnes-image-2.5-flash
# IMAGE_API_KEY=
# IMAGE_BASE_URL=https://api.xkiro.com/v1
# IMAGE_MODEL=sensenova/sensenova-u1.5-lite

# Payments (all three PayOS keys are needed; without them top-up is closed)
# PAYOS_CLIENT_ID=
# PAYOS_API_KEY=
# PAYOS_CHECKSUM_KEY=
# PAYOS_BASE_URL=https://api-merchant.payos.vn
# PUBLIC_SITE_URL=http://localhost:8080

# Telegram alert bot (checked every 5 minutes; off unless both are set). Thresholds below are the defaults
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# ALERT_COOLDOWN_MIN=60
# ALERT_SIGNUPS_1H=10
# ALERT_AI_ERR_RATE=0.3
# ALERT_AI_MIN_CALLS=10
# ALERT_AI_COST_USD=5
# ALERT_MAINTENANCE_MIN=120
